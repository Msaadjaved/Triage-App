# --- LLM (OpenRouter, OpenAI-compatible) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Comma-separated list for the model menu (F5). The default model is added automatically.
LLM_MODELS=openai/gpt-4o-mini,google/gemini-2.5-flash

# --- Decision model (vLLM Semantic Router free API, key from https://decision.vllm-sr.ai) ---
DECISION_BASE_URL=https://decision.vllm-sr.ai
DECISION_API_KEY=
DM_MODEL=vllm-sr/d3
# Price per million input tokens (0 for the free API)
DM_PRICE_PER_M_INPUT=0
# dm+llm: below this confidence (min of category/priority) the LLM takes over
DM_CONFIDENCE_THRESHOLD=0.8
